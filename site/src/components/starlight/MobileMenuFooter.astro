---
// Starlight override: on narrow screens the site navigation lives in the menu drawer.
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import { APP_URL, PRIMARY_NAV, isCurrent } from '../../data/site-links';

const pathname = Astro.url.pathname;
---

<nav aria-label="Site" class="mobile-site-nav">
	<ul>
		{
			PRIMARY_NAV.map((link) => (
				<li>
					<a href={link.href} aria-current={isCurrent(link, pathname) ? 'page' : undefined}>
						{link.label}
					</a>
				</li>
			))
		}
		<li><a href={APP_URL}>Launch App →</a></li>
	</ul>
	<p class="note">The browser app needs a tablet or desktop. On phones, use the desktop downloads.</p>
</nav>
<div class="mobile-preferences sl-flex">
	<div class="social-icons">
		<SocialIcons />
	</div>
	<ThemeSelect />
</div>

<style>
	.mobile-site-nav {
		border-top: 1px solid var(--sl-color-gray-6);
		padding-block: 0.75rem;
	}
	.mobile-site-nav ul {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.mobile-site-nav a {
		display: block;
		padding-block: 0.4rem;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		text-decoration: none;
	}
	.mobile-site-nav a[aria-current='page'] {
		color: var(--sl-color-text-accent);
		font-weight: 600;
	}
	.note {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	.social-icons {
		display: flex;
		margin-inline-end: auto;
		gap: 1rem;
		align-items: center;
		padding-block: 1rem;
	}
	.mobile-preferences {
		justify-content: space-between;
		flex-wrap: wrap;
		border-top: 1px solid var(--sl-color-gray-6);
		column-gap: 1rem;
		padding: 0.5rem 0;
	}
</style>
