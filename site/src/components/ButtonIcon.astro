---
// Small inline icons used on marketing buttons (copied from the current site).
interface Props {
	name: 'download' | 'arrow' | 'coffee';
}
const { name } = Astro.props;
---

{name === 'download' && (
	<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1.5a.5.5 0 0 1 .5.5v7.29l2.65-2.64a.5.5 0 1 1 .7.7l-3.5 3.5a.5.5 0 0 1-.7 0l-3.5-3.5a.5.5 0 1 1 .7-.7L7.5 9.29V2a.5.5 0 0 1 .5-.5zm-5 11a.5.5 0 0 1 .5.5v.5h9V13a.5.5 0 0 1 1 0v1a.5.5 0 0 1-.5.5h-10A.5.5 0 0 1 2.5 14v-1a.5.5 0 0 1 .5-.5z"/></svg>
)}
{name === 'arrow' && (
	<svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 8a.5.5 0 0 1 .5-.5h7.29L8.15 4.85a.5.5 0 1 1 .7-.7l3.5 3.5a.5.5 0 0 1 0 .7l-3.5 3.5a.5.5 0 1 1-.7-.7l2.64-2.65H3.5A.5.5 0 0 1 3 8z"/></svg>
)}
{name === 'coffee' && (
	<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
)}
