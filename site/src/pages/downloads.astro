---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import ButtonIcon from '../components/ButtonIcon.astro';
import { APP_URL, COFFEE_URL, PREVIEW_APP_URL, RELEASES_URL } from '../data/site-links';

const title = 'Downloads — PureCutCNC';
const description =
	'Download PureCutCNC for macOS, Windows, or Linux: stable releases and preview builds, tracked per platform.';

// Card contents come from downloads/{channel}/{platform}.json at runtime; the app
// repository's release workflows rewrite those files.
const platforms = [
	{ id: 'macos', name: 'macOS', copy: 'Universal desktop build packaged as a DMG.' },
	{ id: 'windows', name: 'Windows', copy: 'Stable builds publish MSI and NSIS. Preview builds publish NSIS only.' },
	{ id: 'linux', name: 'Linux', copy: 'Portable AppImage plus Debian package.' },
];
const channels = [
	{ id: 'stable', label: 'Stable' },
	{ id: 'snapshot', label: 'Preview Build' },
];
---

<MarketingLayout title={title} description={description}>
	<div class="hero hero--compact">
		<div class="hero-grid"></div>
		<div class="hero-badge"><span class="dot"></span> Desktop Builds</div>
		<h1>Stable releases and <em>preview builds</em>, one page.</h1>
		<p class="hero-sub">
			Download PureCutCNC for macOS, Windows, or Linux. This page tracks the latest published desktop artifacts per
			platform and track. Stable is the safer path. Preview Build is the newest in-progress track.
		</p>
		<div class="hero-actions">
			<a href={RELEASES_URL} class="btn-primary">Open all GitHub releases</a>
			<a href={APP_URL} class="btn-secondary desktop-web-link">Use browser version</a>
			<a href={PREVIEW_APP_URL} class="btn-secondary desktop-web-link">Open Preview Build</a>
			<p class="desktop-web-only-note">The browser app needs a tablet or desktop. On phones, use the desktop downloads above.</p>
		</div>
	</div>

	<div class="downloads">
		<section class="support-banner" aria-label="Support PureCutCNC">
			<p>
				<strong>PureCutCNC is free, and stays free</strong> — but building and maintaining it takes real time and money.
				If it helps you, a coffee keeps it going.
			</p>
			<a href={COFFEE_URL} class="btn-coffee" target="_blank" rel="noopener noreferrer">
				<ButtonIcon name="coffee" /> Buy me a coffee
			</a>
		</section>

		<div class="page-grid">
			<section class="panel" aria-labelledby="matrix-title">
				<div class="panel-head">
					<div class="panel-label">Download Matrix</div>
					<h2 id="matrix-title">Per-platform release tracks</h2>
					<p>Each cell below pulls from public metadata written by the build workflows after a release finishes.</p>
				</div>
				<div class="matrix" role="table" aria-label="Desktop downloads by platform and track">
					<div class="matrix-row matrix-head" role="row">
						<div role="columnheader"><span class="sr-only">Platform</span></div>
						{channels.map((channel) => <div role="columnheader">{channel.label}</div>)}
					</div>
					{
						platforms.map((platform) => (
							<div class="matrix-row" role="row">
								<div role="rowheader">
									<div class="platform-name">{platform.name}</div>
									<div class="platform-copy">{platform.copy}</div>
								</div>
								{channels.map((channel) => (
									<div role="cell">
										<span class="channel-label">{channel.label}</span>
										<div data-platform={platform.id} data-channel={channel.id} aria-live="polite">
											<div class="loading-state">Checking the latest {channel.label.toLowerCase()} build…</div>
										</div>
									</div>
								))}
							</div>
						))
					}
				</div>
			</section>

			<div class="stack">
				<section class="panel note-card">
					<div class="panel-label">Choose a Track</div>
					<h3>Stable or Preview Build</h3>
					<p>
						<strong>Stable</strong> is the safer install for regular use. <strong>Preview Build</strong> is the newest
						in-progress desktop build and is better for testing recent changes before the next full release.
					</p>
					<ul>
						<li>Choose <strong>stable</strong> if you want the most conservative desktop build.</li>
						<li>Choose <strong>Preview Build</strong> if you are validating current work or checking a recent fix.</li>
						<li>If a platform/track has no package yet, that card will stay unavailable until the next build is published.</li>
					</ul>
				</section>

				<section class="panel note-card">
					<div class="panel-label">Also Available in the Browser</div>
					<h3>No install needed for a quick session</h3>
					<p>
						If you want to try features without downloading, the browser version of PureCutCNC runs on any modern
						desktop or tablet browser. The same project files work across desktop and browser.
					</p>
					<div class="note-actions">
						<a href={APP_URL} class="btn-primary desktop-web-link">Open stable web app</a>
						<a href={PREVIEW_APP_URL} class="btn-secondary desktop-web-link">Open Preview Build</a>
						<p class="desktop-web-only-note">The browser app needs a tablet or desktop. On phones, use the desktop downloads above.</p>
					</div>
				</section>

				<section class="panel note-card">
					<div class="panel-label">System Requirements</div>
					<h3>What you need</h3>
					<ul>
						<li>
							<strong>Browser app:</strong> a current desktop or tablet browser (Chrome, Edge, Firefox, or Safari) with
							WebGL2 — the GPU heightfield simulation requires it.
						</li>
						<li>
							<strong>Desktop builds:</strong> macOS 11+ (universal), Windows 10/11 (x64), Linux x86_64 with glibc 2.31+
							(AppImage or .deb).
						</li>
						<li><strong>Project data</strong> stays on your machine. No account, no cloud storage, no upload.</li>
					</ul>
				</section>

				<section class="panel note-card">
					<div class="panel-label">What's New</div>
					<h3>See the changelog</h3>
					<p>
						Every release publishes notes on GitHub — PRs, fixes, and new ops are listed there. The latest stable is <a id="js-latest-stable" href={RELEASES_URL}>the most recent non-prerelease tag</a>;
						preview builds track the main branch.
					</p>
					<ul>
						<li><a href={RELEASES_URL}>All releases &amp; release notes</a></li>
						<li><a href="https://github.com/PureCutCNC/purecutcnc/blob/main/RELEASE_NOTES.md">RELEASE_NOTES.md</a></li>
					</ul>
				</section>

				<section class="panel note-card">
					<div class="panel-label">Support</div>
					<h3>Keep PureCutCNC going</h3>
					<p>
						PureCutCNC is free, and it stays free — no accounts, no paywalls. But developing and maintaining it (and the
						tools and hosting behind it) takes real time and money. If it has saved you time, buying me a coffee genuinely
						helps keep it going. No pressure — and thank you for using it.
					</p>
					<div class="note-actions">
						<a href={COFFEE_URL} class="btn-coffee" target="_blank" rel="noopener noreferrer">
							<ButtonIcon name="coffee" /> Buy me a coffee
						</a>
					</div>
				</section>
			</div>
		</div>
	</div>
</MarketingLayout>

<script>
	interface DownloadAsset {
		name: string;
		label?: string;
		kind?: string;
		url: string;
	}

	interface DownloadMetadata {
		channel: string;
		version: string;
		releaseUrl: string;
		updatedAt?: string;
		assets?: DownloadAsset[];
	}

	interface LatestStable {
		tag: string;
		url?: string;
	}

	const CHANNEL_LABELS: Record<string, string> = { stable: 'Stable', snapshot: 'Preview Build' };

	function escapeHtml(value: unknown): string {
		return String(value).replace(
			/[&<>"']/g,
			(char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char] as string
		);
	}

	function formatDate(iso?: string): string {
		const date = iso ? new Date(iso) : null;
		if (!date || Number.isNaN(date.getTime())) return 'Not published yet';
		return date.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' });
	}

	function chip(channel: string): string {
		return `<div class="channel-chip ${escapeHtml(channel)}">${escapeHtml(CHANNEL_LABELS[channel] ?? channel)}</div>`;
	}

	function renderUnavailable(channel: string, latestStable: LatestStable | null): string {
		let message = 'No published build has been recorded for this platform/track yet.';
		if (channel === 'stable') {
			const label = escapeHtml(latestStable?.tag ?? 'the most recent release');
			const href = escapeHtml(latestStable?.url ?? 'https://github.com/PureCutCNC/purecutcnc/releases');
			message = `Latest stable release (<a href="${href}">${label}</a>) shipped without desktop binaries for this platform. Use the <strong>Preview Build</strong> column for the newest installable build, or grab any binary directly from <a href="https://github.com/PureCutCNC/purecutcnc/releases">GitHub releases</a>.`;
		}
		return `<div class="channel-card">${chip(channel)}<div class="empty-state">${message}</div></div>`;
	}

	function renderCard(data: DownloadMetadata, latestStable: LatestStable | null): string {
		if (!data.assets?.length) return renderUnavailable(data.channel, latestStable);
		const assets = data.assets
			.map(
				(asset) =>
					`<a class="asset-link" href="${escapeHtml(asset.url)}"><span>${escapeHtml(asset.label || asset.name)}</span><span class="asset-kind">${escapeHtml(asset.kind || 'file')}</span></a>`
			)
			.join('');
		return `<div class="channel-card">
			${chip(data.channel)}
			<div class="version-line">v${escapeHtml(data.version)}</div>
			<div class="meta-line">Updated ${escapeHtml(formatDate(data.updatedAt))}</div>
			<div class="asset-list">${assets}</div>
			<div class="meta-line"><a href="${escapeHtml(data.releaseUrl)}">View release notes</a></div>
		</div>`;
	}

	async function loadLatestStable(): Promise<LatestStable | null> {
		try {
			const response = await fetch('https://api.github.com/repos/PureCutCNC/purecutcnc/releases/latest', {
				headers: { Accept: 'application/vnd.github+json' },
			});
			if (!response.ok) return null;
			const data = await response.json();
			return data?.tag_name ? { tag: data.tag_name, url: data.html_url } : null;
		} catch {
			return null;
		}
	}

	async function loadCard(mount: HTMLElement, latestStable: LatestStable | null) {
		const { platform, channel = 'stable' } = mount.dataset;
		try {
			const response = await fetch(`/downloads/${channel}/${platform}.json`, { cache: 'no-store' });
			if (!response.ok) throw new Error(`HTTP ${response.status}`);
			mount.innerHTML = renderCard(await response.json(), latestStable);
		} catch {
			mount.innerHTML = renderUnavailable(channel, latestStable);
		}
	}

	(async () => {
		const latestStable = await loadLatestStable();
		const faqLink = document.getElementById('js-latest-stable');
		if (faqLink && latestStable) {
			faqLink.textContent = latestStable.tag;
			if (latestStable.url) faqLink.setAttribute('href', latestStable.url);
		}
		const mounts = document.querySelectorAll<HTMLElement>('[data-platform][data-channel]');
		await Promise.all(Array.from(mounts, (mount) => loadCard(mount, latestStable)));
	})();
</script>
